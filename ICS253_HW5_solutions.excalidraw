			"isDeleted": false,
			"boundElements": [],
			"updated": 1795280929350,
			"link": null,
			"locked": false,
			"text": "The basis shows P(8), P(9), P(10). The inductive step shows\n   P(k+1) from the\nIH for every k ≥ 10, i.e. every n ≥ 11. Together, P(n) is true\n   for all n ≥ 8.",
			"originalText": "The basis shows P(8), P(9), P(10). The inductive step shows\n   P(k+1) from the\nIH for every k ≥ 10, i.e. every n ≥ 11. Together, P(n) is true\n   for all n ≥ 8.",
			"fontSize": 18,
			"fontFamily": 1,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"lineHeight": 1.25,
			"autoResize": true,
