		{
			"type": "text",
			"id": "e22",
			"x": 22.54528227306548,
			"y": 1247.3280186859815,
			"width": 590.7562255859375,
			"height": 202.5,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"roundness": null,
			"seed": 109166722,
			"version": 108,
			"versionNonce": 1248072334,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1795280980252,
			"locked": false,
			"text": "Basis n = 0:  LHS = 1² = 1,  RHS = 1·1·3/3 = 1  ✓\nIH:  assume 1 + 3² + … + (2k+1)² = (k+1)(2k+1)(2k+3)/3  for some\n   k ≥ 0.\nStep: add (2k+3)² to both sides (IH used):\n(k+1)(2k+1)(2k+3)/3 + (2k+3)²\n    = (2k+3) [ (k+1)(2k+1) + 3(2k+3) ] / 3\n    = (2k+3)(2k² + 9k + 10)/3\n    = (2k+3)(k+2)(2k+5)/3\n    = (k+2)(2(k+1)+1)(2(k+1)+3)/3  =  P(k+1)  ✓",
			"originalText": "Basis n = 0:  LHS = 1² = 1,  RHS = 1·1·3/3 = 1  ✓\nIH:  assume 1 + 3² + … + (2k+1)² = (k+1)(2k+1)(2k+3)/3  for some\n   k ≥ 0.\nStep: add (2k+3)² to both sides (IH used):\n(k+1)(2k+1)(2k+3)/3 + (2k+3)²\n    = (2k+3) [ (k+1)(2k+1) + 3(2k+3) ] / 3\n    = (2k+3)(2k² + 9k + 10)/3\n    = (2k+3)(k+2)(2k+5)/3\n    = (k+2)(2(k+1)+1)(2(k+1)+3)/3  =  P(k+1)  ✓",
			"fontSize": 18,
			"fontFamily": 1,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"lineHeight": 1.25,
			"autoResize": true,
			"index": "b08K",
			"created": null,
			"hasTextLink": false,
			"rawText": "Basis n = 0:  LHS = 1² = 1,  RHS = 1·1·3/3 = 1  ✓\nIH:  assume 1 + 3² + … + (2k+1)² = (k+1)(2k+1)(2k+3)/3  for some\n   k ≥ 0.\nStep: add (2k+3)² to both sides (IH used):\n(k+1)(2k+1)(2k+3)/3 + (2k+3)²\n    = (2k+3) [ (k+1)(2k+1) + 3(2k+3) ] / 3\n    = (2k+3)(2k² + 9k + 10)/3\n    = (2k+3)(k+2)(2k+5)/3\n    = (k+2)(2(k+1)+1)(2(k+1)+3)/3  =  P(k+1)  ✓",
			"labelPosition": null,
			"baseFontSize": null
		},
