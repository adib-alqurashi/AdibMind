			"updated": 1795280929346,
			"link": null,
			"locked": false,
			"text": "Start (0,0)\n1st: (2,3), (3,2)\n2nd: (4,6), (5,5), (6,4)\n3rd: (6,9), (7,8), (8,7), (9,6)\n4th: (8,12), (9,11), (10,10), (11,9), (12,8)\n5th: (10,15), (11,14), (12,13), (13,12), (14,11), (15,10)",
			"originalText": "Start (0,0)\n1st: (2,3), (3,2)\n2nd: (4,6), (5,5), (6,4)\n3rd: (6,9), (7,8), (8,7), (9,6)\n4th: (8,12), (9,11), (10,10), (11,9), (12,8)\n5th: (10,15), (11,14), (12,13), (13,12), (14,11), (15,10)",
