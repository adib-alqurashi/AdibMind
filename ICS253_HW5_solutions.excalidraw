			"updated": 1795280929350,
			"link": null,
			"locked": false,
			"text": "P(8): 8 = 3 + 5\nP(9): 9 = 3 + 3 + 3\nP(10): 10 = 5 + 5\nAll true, so the basis step is done.",
			"originalText": "P(8): 8 = 3 + 5\nP(9): 9 = 3 + 3 + 3\nP(10): 10 = 5 + 5\nAll true, so the basis step is done.",
			"fontSize": 18,
			"fontFamily": 1,
