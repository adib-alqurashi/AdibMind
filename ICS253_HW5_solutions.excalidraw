		{
			"type": "text",
			"id": "e25",
			"x": 20,
			"y": 1549.4743237599996,
			"width": 660,
			"height": 135,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
