		{
			"type": "text",
			"id": "e28",
			"x": 20,
			"y": 1827.7552324799997,
			"width": 660,
			"height": 247.5,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
