			"id": "e16",
			"x": 20,
			"y": 744.2543879199998,
			"width": 660,
			"height": 157.5,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
