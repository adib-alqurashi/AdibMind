		{
			"type": "text",
			"id": "e97",
			"x": 1620,
			"y": 1671.9570477599996,
			"width": 660,
			"height": 180,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
			"roughness": 0,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"roundness": null,
			"seed": 534004670,
			"version": 2,
			"versionNonce": 948158994,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1795280929346,
			"link": null,
			"locked": false,
			"text": "Fibonacci:  f₀ = 0,  f₁ = 1,  fₙ₊₁ = fₙ + fₙ₋₁.\nBasis n = 1:  f₂f₀ − f₁² = 1·0 − 1 = −1 = (−1)¹  ✓\nIH:  fₖ₊₁fₖ₋₁ − fₖ² = (−1)ᵏ  for some k ≥ 1.\nStep: fₖ₊₂fₖ − fₖ₊₁² = (fₖ₊₁ + fₖ)fₖ − fₖ₊₁²\n    = fₖ₊₁(fₖ − fₖ₊₁) + fₖ²\n    = −fₖ₊₁fₖ₋₁ + fₖ²         (since fₖ − fₖ₊₁ = −fₖ₋₁)\n    = −(fₖ₊₁fₖ₋₁ − fₖ²)\n    = −(−1)ᵏ = (−1)ᵏ⁺¹   (IH used)  ✓",
			"originalText": "Fibonacci:  f₀ = 0,  f₁ = 1,  fₙ₊₁ = fₙ + fₙ₋₁.\nBasis n = 1:  f₂f₀ − f₁² = 1·0 − 1 = −1 = (−1)¹  ✓\nIH:  fₖ₊₁fₖ₋₁ − fₖ² = (−1)ᵏ  for some k ≥ 1.\nStep: fₖ₊₂fₖ − fₖ₊₁² = (fₖ₊₁ + fₖ)fₖ − fₖ₊₁²\n    = fₖ₊₁(fₖ − fₖ₊₁) + fₖ²\n    = −fₖ₊₁fₖ₋₁ + fₖ²         (since fₖ − fₖ₊₁ = −fₖ₋₁)\n    = −(fₖ₊₁fₖ₋₁ − fₖ²)\n    = −(−1)ᵏ = (−1)ᵏ⁺¹   (IH used)  ✓",
			"fontSize": 18,
			"fontFamily": 1,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"lineHeight": 1.25,
			"autoResize": true,
			"index": "b0Z",
			"created": null,
			"hasTextLink": false,
			"rawText": "",
